{
  "info": {
    "name": "PrazoCerto MVP API",
    "description": "Collection completa para testes do MVP do PrazoCerto",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Status da API",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "status"
          ]
        }
      }
    },
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login (Demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@prazocerto.local\",\n  \"senha\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Cadastro de Estabelecimento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome_estabelecimento\": \"Padaria do Povo\",\n  \"nome_responsavel\": \"Carlos Andrade\",\n  \"email\": \"carlos@padaria.com\",\n  \"senha\": \"senha123\",\n  \"dias_antecedencia_alerta\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Configurações",
      "item": [
        {
          "name": "Obter Configurações",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/configuracoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "configuracoes"
              ]
            }
          }
        },
        {
          "name": "Atualizar Dias de Antecedência",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dias_antecedencia\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/configuracoes/antecedencia",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "configuracoes",
                "antecedencia"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Produtos e Farol",
      "item": [
        {
          "name": "Listar Painel Farol",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            }
          }
        },
        {
          "name": "Cadastrar Produto / Lote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Queijo Prato Fatiado 200g\",\n  \"codigoBarras\": \"7891234567890\",\n  \"lote\": \"LT-2026-01\",\n  \"quantidade\": 15,\n  \"dataValidade\": \"2026-11-20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            }
          }
        },
        {
          "name": "Dar Baixa em Lote",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VENDIDO_PROMOCAO\",\n  \"quantidade\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/produtos/1/baixa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "1",
                "baixa"
              ]
            }
          }
        },
        {
          "name": "Excluir Lote",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}
